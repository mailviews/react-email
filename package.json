{
  "name": "@mailviews/react-email",
  "version": "0.1.0",
  "description": "Base components, Tailwind setup and layout for Mailviews React Email components",
  "license": "MIT",
  "homepage": "https://mailviews.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailviews/react-email.git"
  },
  "bugs": {
    "url": "https://github.com/mailviews/react-email/issues"
  },
  "keywords": [
    "react-email",
    "email",
    "html-email",
    "tailwindcss",
    "mailviews",
    "maizzle",
    "outlook"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:theme": "tsx scripts/build-theme.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:theme && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0 || ^19.0",
    "react-email": ">=6.2.0"
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@maizzle/tailwindcss": "^1.5.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "react": "^19.2.4",
    "react-email": "6.9.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
